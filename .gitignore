# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Notebooks — outputs are stripped before commit (see CONTRIBUTING.md)
.ipynb_checkpoints/
*.executed.ipynb

# Local data, if you download the real MultiHop-RAG
data/
*.parquet

# Never commit these
.env
.env.*
*.pem
credentials*
.aws/

# OS / editor
.DS_Store
Thumbs.db
.idea/

# .vscode/ is tracked on purpose. The tasks file *is* the Codespaces UI — it puts the whole
# lab loop in the command palette — and CI checks its unit pick-list against the registry.
# Personal overrides go in .vscode/*.local.json, which is ignored below.
.vscode/*.local.json
.vscode/launch.json
!.vscode/settings.json

# Documentation linters only — see package.json
node_modules/
package-lock.json

# Your practice scores, not the repo's
interview-bank/.progress.json
