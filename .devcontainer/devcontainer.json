{
  "name": "Advanced RAG & Evals Lab",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",

  // Runs during a Codespaces *prebuild*, so a learner opening this repository gets a machine
  // with everything already installed rather than watching pip for two minutes. Keep anything
  // slow and cacheable here; keep anything that depends on the learner in postAttachCommand.
  "onCreateCommand": "bash .devcontainer/setup.sh",

  // Runs every time somebody attaches, including on a resumed Codespace.
  "postAttachCommand": "bash .devcontainer/welcome.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-toolsai.jupyter",
        "redhat.vscode-yaml",
        "bierner.markdown-mermaid",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests", "-m", "not notebooks"],
        "editor.rulers": [100],
        "files.trimTrailingWhitespace": true,
        "terminal.integrated.defaultProfile.linux": "bash",
        "markdown.preview.breaks": false,

        // The worked answers and the reference solutions are in the repository on purpose —
        // CI grades them on every change, and hiding them from git would make the graders
        // untestable. They are hidden from the explorer and from search instead, because
        // "don't look" is a weak defence when the file is two clicks away in a sidebar.
        //
        // To read one deliberately: open it from the terminal, or flip these to false in
        // .vscode/settings.json. Deliberate is the whole distinction.
        "files.exclude": {
          "**/lab-simulator/units/*/reference": true,
          "**/lab-simulator/units/*/SOLUTION.md": true
        },
        "search.exclude": {
          "**/lab-simulator/units/*/reference": true,
          "**/lab-simulator/units/*/SOLUTION.md": true
        }
      }
    },
    "codespaces": {
      "openFiles": ["lab-simulator/README.md"]
    }
  },

  "hostRequirements": { "cpus": 2, "memory": "4gb", "storage": "32gb" },
  "remoteUser": "vscode"
}
